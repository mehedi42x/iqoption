APP_NAME=IQ Option Modular Automation API
API_HOST=127.0.0.1
API_PORT=8000

# demo currently uses only the local simulator; real fails closed until a secure,
# supported IQ Option adapter is implemented and reviewed.
ACCOUNT_MODE=demo
BROKER_MODE=paper

# Select one supported board for strategy automation: turbo, option, binary, margin.
TRADE_TYPE=binary
# Any symbol accepted by the target venue can be configured here (for example EURUSD or USD/JPY-OTC).
STRATEGY_SYMBOL=EURUSD

TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false
MAX_STAKE=1.00
DEFAULT_DURATION_SECONDS=60
MARKET_DATA_INTERVAL_SECONDS=60
TURBO_DURATION_SECONDS=60
OPTION_DURATION_SECONDS=60
BINARY_DURATION_SECONDS=60
MARGIN_DURATION_SECONDS=60
AUTO_INTERVAL_SECONDS=60
STRATEGY_NAME=sma_cross
DATABASE_PATH=data/trades.sqlite3

# Reserved placeholders only: this project does not currently connect to IQ Option.
# Never commit real credentials or a populated .env file.
IQ_OPTION_EMAIL=
IQ_OPTION_PASSWORD=
